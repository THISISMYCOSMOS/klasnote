{
  "manifest_version": 3,
  "name": "klasnote",
  "version": "0.1.4",
  "minimum_chrome_version": "116",
  "description": "Groq로 강의를 받아쓰고, 본인 Claude/Codex 계정으로 선택한 강의의 요약 노트를 만듭니다.",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "nativeMessaging",
    "downloads",
    "sidePanel"
  ],
  "host_permissions": [
    "https://kwcommons.kw.ac.kr/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "klasnote 패널 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://klas.kw.ac.kr/*"
      ],
      "js": [
        "content/klas-status.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://klas.kw.ac.kr/std/lis/evltn/OnlineCntntsStdPage.do*"
      ],
      "js": [
        "content/klas-list-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://klas.kw.ac.kr/std/lis/evltn/OnlineCntntsStdPage.do*"
      ],
      "js": [
        "content/klas-list.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://kwcommons.kw.ac.kr/em/*",
        "https://kwcommons.kw.ac.kr/viewer/ssplayer/*"
      ],
      "js": [
        "content/kw-player.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "note-launch.html"
      ],
      "matches": [
        "file:///*"
      ],
      "use_dynamic_url": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
